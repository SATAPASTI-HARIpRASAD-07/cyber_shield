# ============================================================
# CYBER SHIELD X - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and configure your production environment

# Provider options: resend, sendgrid, or smtp
EMAIL_PROVIDER=resend

# Resend API Key (Obtain from https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email Address
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Cyber Shield X Security Suite

# Backend Server Port
PORT=5000
